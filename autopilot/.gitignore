node_modules/
.DS_Store

# Отчёты приёмки накапливаются каждый проход. В git нужны состояние и очереди,
# а не история отдельных дней — она восстанавливается из коммитов контента.
data/report-*.json
data/reconcile-report-*.json
data/backups/
data/lock-events.jsonl
data/.autopilot.lock
data/.autopilot.lock.reap
data/*.candidate-*
data/*.tmp-*
data/*.bak

# data/orders.json НЕ игнорируется, хотя и выглядит временным файлом прохода.
# В облаке каждый запуск стартует с чистого клона: без наряды прошлого прохода
# не переживают запуск, перенос незакрытых нарядов в pipeline.mjs не находит
# что переносить, и занятые слоты не освобождаются никогда — контур встаёт на
# восьми зависших нарядах и молча перестаёт выдавать работу.

# Служебные файлы контура, которые обязаны переживать чистый клон: очередь
# отложенного выпуска и суточный журнал публикаций. НЕ игнорируются.

# Политика данных research/chats (AP-P0-25): черновики ресёрча и транскрипты
# могут содержать чувствительные данные — в репозиторий они не попадают.
chats/
research/
.agents/chats/
.agents/research/

# Секреты и ключи.
.env
.env.*
*.pem
*.key
id_rsa*
